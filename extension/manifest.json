{
  "manifest_version": 3,
  "name": "Agria Commercial",
  "short_name": "Agria Commercial",
  "version": "0.3.3",
  "description": "Agria Commercial: Scout per il prospecting e HubSpot, Navigatore per le chiamate commerciali.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Apri Agria Commercial",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*", "https://api.hubapi.com/*"]
}
